# Copy to .env at repository root. Never commit .env.
# PostgreSQL/Neon: use the DIRECT connection endpoint for session advisory locks.
DATABASE_URL=postgresql+psycopg://careeros:careeros_local@localhost:5432/careeros
# For a quick local demo without Docker, use sqlite:///./careeros.db
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# Only explicitly approved official JSON feed domains; empty disables custom feeds.
ALLOWED_FEED_HOSTS=
# Optional: no key means notifications stay in the app.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: no key/model means deterministic extraction.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Only used by the explicit demo seed command. Choose your own password.
DEMO_EMAIL=mohit@example.com
DEMO_PASSWORD=
